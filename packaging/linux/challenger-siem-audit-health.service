[Unit]
Description=Challenger SIEM bounded Linux audit health sampler
After=auditd.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/lib/challenger-siem/challenger-siem-audit-health
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_AUDIT_CONTROL
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
TasksMax=16
MemoryMax=32M
