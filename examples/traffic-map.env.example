# Load these non-secret settings alongside the private database and Auth values
# required by Challenger SIEM. Choose an approximate origin for your deployment.
TrafficMap__Enabled=true
TrafficMap__ReadOnlyDatabase=false
TrafficMap__PublicBaseUrl=http://127.0.0.1:5081
TrafficMap__Origin__Label="Operator-selected approximate origin"
TrafficMap__Origin__Latitude=0
TrafficMap__Origin__Longitude=0
TrafficMap__Geolocation__Enabled=true
TrafficMap__Geolocation__CachePath=.local/traffic-map/geolocation.sqlite3
