# Load these non-secret settings alongside the private database and Auth values
# required by Challenger SIEM. Choose an approximate origin for your deployment.
TrafficMap__Enabled=true
TrafficMap__ReadOnlyDatabase=false
TrafficMap__PublicBaseUrl=http://127.0.0.1:55444
TrafficMap__Origin__Label="Operator-selected approximate origin"
TrafficMap__Origin__Latitude=0
TrafficMap__Origin__Longitude=0
TrafficMap__Geolocation__Enabled=true
TrafficMap__Geolocation__Provider=dbip_mmdb
# Obtain these databases separately and keep them outside the project checkout.
TrafficMap__Geolocation__CountryDatabasePath=/srv/challenger-siem-private/geoip/dbip-country-lite.mmdb
TrafficMap__Geolocation__CityDatabasePath=/srv/challenger-siem-private/geoip/dbip-city-lite.mmdb
TrafficMap__Geolocation__AsnDatabasePath=/srv/challenger-siem-private/geoip/dbip-asn-lite.mmdb
TrafficMap__Geolocation__CachePath=/srv/challenger-siem-private/traffic-map/geolocation.sqlite3
