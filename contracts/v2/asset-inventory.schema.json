{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://challenger-siem.local/contracts/v2/asset-inventory.schema.json",
  "title": "Challenger SIEM Asset Inventory Batch v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "sent_at", "snapshots"],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sent_at": { "type": "string", "format": "date-time" },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/snapshot" }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "hostname", "snapshot_type", "collected_at", "items", "summary"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 255 },
        "snapshot_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "collected_at": { "type": "string", "format": "date-time" },
        "host_timezone": { "$ref": "event-envelope.schema.json#/$defs/host_timezone" },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/item" }
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "metadata"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "type": ["string", "null"], "maxLength": 128 },
        "identity": { "type": ["string", "null"], "maxLength": 512 },
        "metadata": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "minLength": 1, "maxLength": 128 },
          "additionalProperties": { "type": "string", "maxLength": 2048 }
        }
      }
    },
    "summary": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "type": "string", "maxLength": 2048 },
      "properties": {
        "generation_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "page_index": { "type": "string", "pattern": "^(?:[1-9]|[12][0-9]|3[0-2])$" },
        "page_count": { "type": "string", "pattern": "^(?:[1-9]|[12][0-9]|3[0-2])$" },
        "page_item_count": { "type": "string", "pattern": "^(?:[0-9]|[1-9][0-9]|1[0-9]{2}|200)$" },
        "total_item_count": { "type": "string", "pattern": "^(?:[0-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|4(?:0[0-8][0-9]|09[0-6]))$" },
        "source_complete": { "enum": ["true", "false"] },
        "source_truncated": { "enum": ["true", "false"] }
      },
      "dependentRequired": {
        "generation_id": ["page_index", "page_count", "page_item_count", "total_item_count", "source_complete", "source_truncated"],
        "page_index": ["generation_id", "page_count", "page_item_count", "total_item_count", "source_complete", "source_truncated"],
        "page_count": ["generation_id", "page_index", "page_item_count", "total_item_count", "source_complete", "source_truncated"]
      }
    }
  }
}
