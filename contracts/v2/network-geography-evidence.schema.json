{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://challenger-siem.local/contracts/v2/network-geography-evidence.schema.json",
  "title": "Challenger SIEM Network Geography Evidence Response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "events", "result_scope", "limitations"],
  "properties": {
    "schema_version": { "type": "string", "const": "challenger-siem.network-geography-evidence.v2" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "agent_id", "event_citation", "hostname", "source_id", "event_time", "severity", "message", "evidence_mode", "direction"],
        "properties": {
          "event_id": { "type": "string", "format": "uuid" },
          "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "event_citation": { "type": "string", "minLength": 1, "maxLength": 256 },
          "hostname": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source_id": { "type": "string", "enum": ["linux-network-socket-snapshot-diff", "linux-network-flow-summary"] },
          "event_code": { "type": "string", "maxLength": 128 },
          "event_time": { "type": "string", "format": "date-time" },
          "severity": { "type": "string", "enum": ["debug", "information", "notice", "warning", "error", "critical", "audit_success", "audit_failure"] },
          "message": { "type": "string", "maxLength": 20000 },
          "evidence_mode": { "type": "string", "enum": ["snapshot_diff", "kernel_flow"] },
          "direction": { "type": "string", "enum": ["inbound", "outbound", "unknown"] },
          "process_image": { "type": "string", "maxLength": 260 }
        }
      }
    },
    "result_scope": { "type": "string", "maxLength": 500 },
    "limitations": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 500 } }
  }
}
