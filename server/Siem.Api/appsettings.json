{
  "ConnectionStrings": {
    "SiemDatabase": "Host=localhost;Port=5432;Database=challenger_siem;Username=siem;Password=change-me"
  },
  "Auth": {
    "EnrollmentToken": "",
    "ServiceToken": ""
  },
  "Ingestion": {
    "MaxEventsPerBatch": 500
  },
  "Storage": {
    "Retention": {
      "Enabled": true,
      "HostedServiceEnabled": true,
      "TargetRetentionDays": 30,
      "ManagedCapacityBytes": 107374182400,
      "HostedServiceIntervalMinutes": 60
    }
  },
  "Review": {
    "StaleAgentMinutes": 15,
    "RecentEventHours": 24,
    "DefaultEventLimit": 100
  },
  "TrafficMap": {
    "Enabled": false,
    "ReadOnlyDatabase": false,
    "PublicBaseUrl": "",
    "Origin": {
      "Label": "",
      "Latitude": null,
      "Longitude": null
    },
    "Map": {
      "TileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "Attribution": "© OpenStreetMap contributors"
    },
    "Geolocation": {
      "Enabled": true,
      "Provider": "ipwhois",
      "EndpointTemplate": "https://ipwho.is/{ip}",
      "ApiKey": "",
      "ApiKeyHeader": "X-Api-Key",
      "CachePath": "",
      "DailyRequestLimit": 900,
      "RequestTimeoutSeconds": 5,
      "SuccessTtlDays": 30,
      "NegativeTtlHours": 6,
      "MaximumQueuedLookups": 2048,
      "MaximumProviderResponseBytes": 65536
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.traffic-map-geolocation": "Warning"
    }
  },
  "AllowedHosts": "*"
}
